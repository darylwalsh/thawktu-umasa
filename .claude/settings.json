{
  "permissions": {
    "deny": ["Read(.env*)", "Read(**/*.age)", "Read(fnox.local.toml)"],
    "allow": ["Bash(mise run *)", "Bash(uv run *)", "Bash(git *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR}\" && mise exec -- uv run --no-project python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_paths.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR}\" && mise exec -- uv run --no-project python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format_edited.py\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
